<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.btc.hackathon</groupId>
  <artifactId>bomberman-viewer</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Bomberman Viewer</name>
  <description>Darstellungsschicht und Moderationskonsole fuer das Hackathon-Bomberman</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <jackson.version>2.22.3</jackson.version>
    <javafx.version>25.0.4</javafx.version>
    <junit.version>5.11.4</junit.version>

    <viewer.mainClass>com.btc.hackathon.viewer.ViewerLauncher</viewer.mainClass>
  </properties>

  <dependencies>
    <!-- JSON des Server-Protokolls. Der WebSocket-Client kommt aus dem JDK
         (java.net.http.WebSocket), deshalb ist das die einzige Laufzeitabhaengigkeit
         neben JavaFX. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- javafx-controls zieht javafx-graphics und javafx-base transitiv.
         Der plattformspezifische Classifier (win/linux/mac) wird ueber das
         openjfx-Parent-POM automatisch aufgeloest. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 3.14.0 scheitert an Java-25-Bytecode ("major version 69"), daher 3.16.0. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- mvn javafx:run startet den Viewer. -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${viewer.mainClass}</mainClass>
          <options>
            <!-- javafx.graphics liegt auf dem Modulepath, Netty auf dem Classpath. -->
            <option>--enable-native-access=javafx.graphics</option>
            <option>--enable-native-access=ALL-UNNAMED</option>
          </options>
        </configuration>
      </plugin>

      <!-- mvn exec:java -Dexec.mainClass=...tools.FakeServer -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>

      <!--
        mvn package erzeugt zusaetzlich ein startbares JAR mit allen Abhaengigkeiten:
            java -jar target/bomberman-viewer-1.0-SNAPSHOT-viewer.jar (Argumente wie im README)

        Damit laeuft der Viewer auf einem Rechner ohne Maven und ohne Projektbaum - nur
        ein JDK 25 wird gebraucht. Die JavaFX-Bibliotheken liegen dann im Classpath statt
        im Modulepath; genau dafuer gibt es ViewerLauncher, der nicht von Application
        erbt (sonst bricht der JDK-Starter mit "JavaFX runtime components are missing" ab).

        3.6.1 scheitert an Java-25-Bytecode, daher 3.6.2.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>viewer</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${viewer.mainClass}</mainClass>
                </transformer>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Mehrere module-info in einem Classpath-JAR sind sinnlos und
                         stoeren manche Werkzeuge; Signaturen passen nach dem
                         Zusammenlegen ohnehin nicht mehr. -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
